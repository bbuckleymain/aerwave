#!/usr/bin/env xdg-open
[Desktop Entry]
Type=Application
Name=Aeris
GenericName=Media Player
Comment=Watch, listen and read — your video, music and audiobook library in one place
Exec=@EXEC@ %f
Icon=aeris
Terminal=false
Categories=AudioVideo;Video;Player;
Keywords=video;music;audiobook;player;library;mpv;
StartupNotify=true
StartupWMClass=aeris
MimeType=video/mp4;video/x-matroska;video/webm;video/quicktime;video/x-msvideo;video/mpeg;video/x-flv;video/x-ms-wmv;video/3gpp;video/x-m4v;video/mp2t;audio/mpeg;audio/flac;audio/x-flac;audio/mp4;audio/x-m4a;audio/x-m4b;audio/ogg;audio/opus;audio/x-wav;audio/x-vorbis+ogg;
